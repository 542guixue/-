{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guixin.local/schemas/judge_result.schema.json",
  "title": "judge_result_envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "assessment_id",
    "allowed_ability_ids",
    "judge_result",
    "trace_id",
    "version"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "assessment_id": { "type": "string", "minLength": 1 },
    "allowed_ability_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "judge_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_updates",
        "verified_skills",
        "reranker_payload",
        "combat_confidence",
        "score_coverage",
        "evidence_refs"
      ],
      "properties": {
        "vector_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ability_id", "score", "evidence_ref", "support_level"],
            "properties": {
              "ability_id": { "type": "string", "minLength": 1 },
              "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "evidence_ref": { "type": "string", "minLength": 1 },
              "support_level": {
                "type": "string",
                "enum": ["direct", "indirect", "insufficient", "not_determinable"]
              }
            }
          }
        },
        "verified_skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reranker_payload": { "type": "string", "minLength": 1, "maxLength": 500 },
        "combat_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "score_coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trace_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 }
  }
}