{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guixin.local/schemas/geek_cert_report.schema.json",
  "title": "geek_cert_report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "candidate",
    "role",
    "assessment",
    "combat_summary",
    "radar_metrics",
    "verified_skills",
    "vector_signature",
    "anti_forgery",
    "evidence_slices",
    "risk_flags",
    "final_recommendation",
    "trace_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "display_name", "city", "years_experience"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "years_experience": { "type": "number", "minimum": 0 }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_schema_id", "role_name", "mode"],
      "properties": {
        "role_schema_id": { "type": "string", "minLength": 1 },
        "role_name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["sandbox", "interview_prd"] }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "status", "started_at", "ended_at", "time_budget_minutes"],
      "properties": {
        "assessment_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["PROVISIONING", "COMBAT_ACTIVE", "EVALUATING", "CERTIFIED", "FAILED"] },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "time_budget_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "combat_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_title", "summary", "checkpoint_count", "injection_count", "fallback_used"],
      "properties": {
        "scenario_title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "checkpoint_count": { "type": "integer", "minimum": 0 },
        "injection_count": { "type": "integer", "minimum": 0 },
        "fallback_used": { "type": "boolean" }
      }
    },
    "radar_metrics": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "label", "score", "weight", "layer"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "layer": { "type": "integer", "enum": [32, 128, 1024] }
        }
      }
    },
    "verified_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "vector_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vec_version", "signature_method", "top_atoms", "layer_coverage"],
      "properties": {
        "vec_version": { "type": "string", "minLength": 1 },
        "signature_method": { "type": "string", "minLength": 1 },
        "top_atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ability_id", "score"],
            "properties": {
              "ability_id": { "type": "string", "minLength": 1 },
              "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "layer_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverage_32", "coverage_128", "coverage_1024"],
          "properties": {
            "coverage_32": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "coverage_128": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "coverage_1024": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        }
      }
    },
    "anti_forgery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "report_digest",
        "judge_digest",
        "vec_version",
        "prompt_version",
        "grader_version",
        "issued_at"
      ],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "report_digest": { "type": "string", "minLength": 1 },
        "judge_digest": { "type": "string", "minLength": 1 },
        "vec_version": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "grader_version": { "type": "string", "minLength": 1 },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    },
    "evidence_slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_type", "source_ref", "summary", "related_ability_ids", "confidence"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "enum": ["diff", "error_log", "checkpoint", "answer", "test_report"] },
          "source_ref": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "related_ability_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "final_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale", "next_action"],
      "properties": {
        "decision": { "type": "string", "enum": ["strong_yes", "yes", "hold", "no"] },
        "rationale": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "trace_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}